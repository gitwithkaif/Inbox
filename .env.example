# ==========================================
# INBOX ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase (Required)
# Found in your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (Required for admin password management & secure backend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Resend Email Configuration (Required for notification emails)
# Found in your Resend dashboard -> API Keys
RESEND_API_KEY=re_123456789

# Admin Email (Recipient of file upload notifications)
ADMIN_EMAIL=your-email@domain.com

# Sender email for notifications (Default: Inbox <noreply@yourdomain.com> or onboarding@resend.dev)
SENDER_EMAIL=Inbox <onboarding@resend.dev>

# Application Base URL (e.g. http://localhost:3000 or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000
